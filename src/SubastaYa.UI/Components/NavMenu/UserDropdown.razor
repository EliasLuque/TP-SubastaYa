<div class="dropdown" @onclick:stopPropagation="true">
    <button class="btn btn-light d-flex align-items-center rounded-pill px-3 py-1 border-0 shadow-sm dropdown-toggle" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-person-circle fs-4 text-secondary me-2"></i>
        <span class="fw-bold me-2">@FormattedBalance</span>
    </button>
    
    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userMenu">
        <li>
            <NavLink class="dropdown-item" href="perfil">Mi Perfil</NavLink>
        </li>
        <li>
            <NavLink class="dropdown-item" href="depositar">Cargar Saldo</NavLink>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <button class="dropdown-item text-danger" @onclick="ExecuteSignOut">
                Cerrar Sesión
            </button>
        </li>
    </ul>
</div>

@code {
    [Parameter]
    public decimal Balance { get; set; } = 0;

    [Parameter]
    public EventCallback OnSignOut { get; set; }

    // Propiedad calculada para formatear el número como dinero (ej: $86)
    private string FormattedBalance => Balance.ToString("C0", new System.Globalization.CultureInfo("en-US"));

    private async Task ExecuteSignOut()
    {
        if (OnSignOut.HasDelegate)
        {
            await OnSignOut.InvokeAsync();
        }
    }
}