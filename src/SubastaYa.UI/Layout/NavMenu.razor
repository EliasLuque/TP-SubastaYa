<nav class="navbar navbar-expand-lg bg-white border-bottom py-3">

    <div class="container-fluid px-4">
        <!-- Logo -->
        <BrandLogo />

        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass navbar-collapse" @onclick="ToggleNavMenu">

            <!-- Central Search Bar -->
            <SearchBar OnSearch="HandleSearch" />
            
            <!-- Links -->
            <ul class="navbar-nav mb-2 mb-lg-0 align-items-center gap-3">
                <li class="nav-item">
                    <NavLink class="nav-link text-dark fw-medium" href="">
                        Explorar
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="btn btn-primary text-white rounded-3 px-3 py-2 fw-medium" href="">
                        Crear Subasta
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link text-dark fw-medium" href="">
                        Mi Billetera
                    </NavLink>
                </li>
                <li>
                    <!-- User Menu -->
                    <UserDropdown Balance="currentUserBalance" OnSignOut="HandleSignOut" />
                </li>
            </ul>
        </div>
    </div>
</nav>


@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    
    private decimal currentUserBalance = 0m;

    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void HandleSearch(string term)
    {
        Navigation.NavigateTo($"/explorar?busqueda={Uri.EscapeDataString(term)}");
    }

    private void HandleSignOut()
    {
        Navigation.NavigateTo("/login");
    }
}
